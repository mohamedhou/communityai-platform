# PostgreSQL connection. Docker Compose uses POSTGRES_HOST=postgres internally.
POSTGRES_DB=communityai
POSTGRES_USER=communityai
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Browser origin allowed to call the backend.
BACKEND_CORS_ORIGINS=http://localhost:5173
# Use development for local demos. Set APP_ENV=production outside local development.
APP_ENV=development
# Production requires a unique JWT secret of at least 32 characters.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_COOKIE_NAME=refresh_token
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax
REFRESH_COOKIE_PATH=/api/v1/auth
MEDIA_ROOT=/app/media
MEDIA_MAX_UPLOAD_BYTES=104857600

# true enables demo data and simulated social connections; false requires real OAuth apps.
SOCIAL_MOCK_MODE=false
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SOCIAL_TOKEN_ENCRYPTION_KEY=
# Meta App ID and App Secret. Obtain them from Meta for Developers; never commit them.
META_CLIENT_ID=
META_CLIENT_SECRET=
# Must exactly match the redirect URI registered in the Meta developer console.
META_REDIRECT_URI=http://localhost:8000/api/v1/social-accounts/meta/callback
# Leave blank to use the backend default, or set a currently supported Graph API version.
META_GRAPH_API_VERSION=
# LinkedIn Client ID and Client Secret. Obtain them from LinkedIn Developers; never commit them.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Must exactly match the Authorized Redirect URL in the LinkedIn developer console.
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/v1/social-accounts/linkedin/callback
# Frontend URL used by OAuth callbacks and browser navigation.
FRONTEND_APP_URL=http://localhost:5173

# AI provider selection. mock is safe for demos; real providers remain backend-only.
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Redis is used by the backend runtime; Docker Compose provides the redis hostname.
REDIS_HOST=redis
REDIS_PORT=6379

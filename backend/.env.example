POSTGRES_DB=communityai
POSTGRES_USER=communityai
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

BACKEND_CORS_ORIGINS=http://localhost:5173
# Use development for local demos. Set APP_ENV=production outside local development.
APP_ENV=development
# Production requires a unique JWT secret of at least 32 characters.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_COOKIE_NAME=refresh_token
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax
REFRESH_COOKIE_PATH=/api/v1/auth
MEDIA_ROOT=/app/media
MEDIA_MAX_UPLOAD_BYTES=104857600

AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

